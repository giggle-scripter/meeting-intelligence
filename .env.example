# Power Automate sends this value in the X-API-Key header.
POWER_AUTOMATE_API_KEY=
MAX_TRANSCRIPT_CHARACTERS=500000

# Optional selective AI fallback. Leave empty for deterministic-only mode.
AI_FALLBACK_ENDPOINT=
AI_FALLBACK_API_KEY=
AI_TIMEOUT_SECONDS=3600
JOB_TIMEOUT_SECONDS=3600
# Maximum distinct clauses sent in one OpenAI/provider request. The pipeline
# batches several ambiguous windows so long transcripts need fewer requests.
AI_MAX_BATCH_CONTEXT_CLAUSES=56
# Optional provider-cost guard. `enforce` fails closed before calls over the
# per-meeting call or payload cap. A USD cap requires all OPENAI pricing values.
AI_COST_GATE_MODE=off
AI_COST_MAX_PROVIDER_CALLS_PER_MEETING=3
AI_COST_MAX_PAYLOAD_CHARACTERS=20000
AI_COST_MAX_ESTIMATED_USD_PER_MEETING=
# Keep V1 as default while V2 is evaluated in shadow mode.
PIPELINE_VERSION=v1
PIPELINE_TRACE_ENABLED=false
PIPELINE_TRACE_DIRECTORY=evaluation/traces

# Use grounded note cues and compact AI context. Set shadow for trace-only A/B.
MEETING_CONTEXT_MODE=assist
MEETING_NOTE_MAX_CHARACTERS=50000
NOTE_GROUNDING_THRESHOLD=0.72
NOTE_GROUNDING_MARGIN=0.12
# Optional dual-view note authority. In assist mode, note claims never create
# direct ledger events; only transcript-grounded signals can enter routing.
NOTE_DUAL_VIEW_MODE=off
NOTE_CLAIM_MAX_TRANSCRIPT_CLAUSES=8
NOTE_CLAIM_MAX_TOPICS=3
NOTE_CLAIM_GROUNDING_THRESHOLD=0.72
NOTE_CLAIM_GROUNDING_MARGIN=0.12
NOTE_DUAL_VIEW_VERSION=note-dual-view-v1
# Deterministic date AST. Off leaves the legacy resolver untouched; shadow
# compares both paths; assist fills only legacy-unresolved supported durations.
TEMPORAL_SEMANTICS_MODE=off
TEMPORAL_PARSER_VERSION=temporal-parser-v1
TEMPORAL_WORKING_DAY_POLICY=weekdays-only-v1
TEMPORAL_MIN_CONFIDENCE=1.0
TOPIC_LIKELY_THRESHOLD=0.45
MAX_MEETING_TOPICS=12
MAX_TOPIC_KEYWORDS=8

# Optional local ML infrastructure. It is not connected to V1 task decisions
# until classifier/retrieval features are introduced in later PRs.
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_FALLBACK_ENABLED=true
EMBEDDING_FALLBACK_DIMENSION=384
ACTION_CLASSIFIER_MODE=off
ACTION_CLASSIFIER_MODEL_PATH=data/ml/action-classifier/model/action-clf-v1.json
# Shadow-only Q1 evidence; it never creates events or tasks.
ACTION_CANDIDATE_BUILDER_MODE=off
ACTION_CANDIDATE_BUILDER_VERSION=action-candidate-v2
# Q2 authority router. In assist it only suppresses candidate-backed legacy
# creates that fail hard-negative or authority checks; it never calls AI.
COMMITMENT_ROUTER_MODE=off
COMMITMENT_ROUTER_VERSION=commitment-router-v2
COMMITMENT_ROUTER_ACTIVE_TYPES=DIRECT_ASSIGNMENT,SELF_COMMITMENT
# Deterministic span-derived action names. Q3 is shadow-only pending a metric
# uplift; raw source and proposed canonical action are retained in trace.
ACTION_CANONICALIZATION_MODE=off
ACTION_CANONICALIZATION_VERSION=action-canonicalization-v2

# Generic recap rows are measured before any lifecycle reconciliation rollout.
RECAP_RECONCILIATION_MODE=off

# Evidence-only owner grounding; never infers an owner from speaker proximity.
OWNER_GROUNDING_MODE=off

# Evidence-only deadline attachment; never assigns a mention by nearest task.
DEADLINE_GROUNDING_MODE=off
CANDIDATE_ROUTER_MODE=off
# Production output changes only when both proposal flags are enabled and the
# classifier/router modes are assist. AI is limited to the uncertain band.
TASK_CREATE_PROPOSAL_ENABLED=false
AI_CREATE_PROPOSAL_ENABLED=false
AI_CREATE_MAX_PROPOSALS_PER_MEETING=3
# Q7 preflight only: audit bounded, grounded uncertain creates before any live
# provider rollout. Requires classifier/candidate/action/commitment shadow.
AI_QUALITY_UPLIFT_MODE=off

# Semantic task identity retrieval is telemetry-only in this PR. Exact task ID
# and exact alias always precede lexical/semantic scoring.
TASK_SEMANTIC_LINKER_MODE=off
CONTEXT_RETRIEVAL_MODE=off
CONTEXT_MAX_CLAUSES=30
CONTEXT_MAX_CHARACTERS=12000
CONTEXT_MAX_TASKS=5
CONTEXT_LOCAL_BEFORE=3
CONTEXT_LOCAL_AFTER=5
CONTEXT_MAX_TOPIC_CLAUSES=12
CONTEXT_MAX_TOPICS=3
CONTEXT_MAX_HISTORY_EVENTS_PER_TASK=3
CONTEXT_TOPIC_BOUNDARY_THRESHOLD=0.42
CONTEXT_TOPIC_SMOOTHING_WINDOW=3
CONTEXT_RETRIEVAL_VERSION=context-retriever-v1
# Bounded mutation router. `off` preserves the legacy path; `shadow` builds
# payloads only and requires both retrieval modes to be shadow; `assist`
# replaces legacy provider resolution for routed anchors after strict Python
# validation. Never enable it without reviewing its traces first.
AI_MUTATION_ROUTER_MODE=off
AI_MUTATION_PROMPT_VERSION=mutation-resolution-v2
AI_MUTATION_MIN_CONFIDENCE=0.70
TASK_LINK_SEMANTIC_WEIGHT=0.55
TASK_LINK_LEXICAL_WEIGHT=0.20
TASK_LINK_TOPIC_WEIGHT=0.10
TASK_LINK_OWNER_WEIGHT=0.10
TASK_LINK_RECENCY_WEIGHT=0.05
TASK_LINK_STRONG_THRESHOLD=0.78
TASK_LINK_MIN_MARGIN=0.12
TASK_LINK_AI_THRESHOLD=0.60
TASK_LINK_RECENCY_HORIZON_CLAUSES=200
TASK_LINK_TOP_K=5
TASK_LINK_SCORING_VERSION=task-link-scoring-v1
ACTION_CLEAR_THRESHOLD=0.82
ACTION_AI_THRESHOLD=0.45
CANDIDATE_THRESHOLD_VERSION=candidate-router-thresholds-v1
# Preferred fallback for the PoC: OpenAI is invoked only for ambiguous windows.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=medium
# Optional USD per 1M tokens. Set all three from the current OpenAI price card
# for OPENAI_MODEL; otherwise traces retain token counts but omit cost estimate.
OPENAI_INPUT_USD_PER_1M=
OPENAI_CACHED_INPUT_USD_PER_1M=
OPENAI_OUTPUT_USD_PER_1M=
AI_FALLBACK_DEBUG=false

# Preferred AI-last provider. Use the full Foundry chat-completions URL.
# Example:
# https://<resource>.services.ai.azure.com/models/chat/completions
AZURE_AI_FOUNDRY_CHAT_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_MODEL=
AZURE_AI_FOUNDRY_API_VERSION=2024-05-01-preview
