{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "job_id", "status", "created_at", "started_at", "completed_at",
    "result", "error", "pipeline_version", "prompt_version", "model",
    "content_hash", "segments_total", "segments_succeeded",
    "segments_failed", "timeout_seconds"
  ],
  "properties": {
    "job_id": {"type": "string", "pattern": "^job-"},
    "status": {"enum": ["queued", "running", "succeeded", "failed"]},
    "created_at": {"type": "string"},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "result": {"type": ["object", "null"]},
    "error": {"type": "string"},
    "pipeline_version": {"type": "string"},
    "prompt_version": {"type": "string"},
    "model": {"type": "string"},
    "content_hash": {"type": "string"},
    "segments_total": {"type": "integer"},
    "segments_succeeded": {"type": "integer"},
    "segments_failed": {"type": "integer"},
    "timeout_seconds": {"type": ["number", "null"]}
  },
  "additionalProperties": false
}
