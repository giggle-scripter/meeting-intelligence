{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MeetingPromptOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meeting_title",
    "summary",
    "tasks"
  ],
  "properties": {
    "meeting_title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_name",
          "assignee",
          "start_date",
          "due_date",
          "due_date_text",
          "evidence",
          "status"
        ],
        "properties": {
          "task_name": {
            "type": "string"
          },
          "assignee": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "due_date": {
            "type": "string",
            "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "due_date_text": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Proposed"
            ]
          }
        }
      }
    }
  }
}
