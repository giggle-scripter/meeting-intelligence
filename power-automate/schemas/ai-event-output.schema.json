{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_type",
          "action_text",
          "assignee",
          "anchor_clause_id",
          "source_clause_ids",
          "deadline_mention_id",
          "related_task_hint",
          "confidence"
        ],
        "properties": {
          "event_type": {
            "type": "string",
            "enum": [
              "TASK_CREATE",
              "TASK_COMMITMENT",
              "OWNER_ASSIGN",
              "OWNER_REASSIGN",
              "DEADLINE_SET",
              "DEADLINE_REPLACE",
              "TASK_CANCEL",
              "TASK_REJECT"
            ]
          },
          "action_text": {"type": "string"},
          "assignee": {"type": "string"},
          "anchor_clause_id": {"type": "string"},
          "source_clause_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["clause_id"],
              "properties": {
                "clause_id": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "deadline_mention_id": {"type": "string"},
          "related_task_hint": {"type": "string"},
          "confidence": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
